# ==================================================
# HMS Server Environment Variables
# ==================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ==================================================

# Server
NODE_ENV=development
PORT=5000

# MongoDB
# Local: mongodb://localhost:27017/hms
# Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/hms
MONGODB_URI=mongodb://localhost:27017/hms

# JWT
JWT_SECRET=your_jwt_secret_here_change_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_secret_here_change_in_production
JWT_REFRESH_EXPIRES_IN=30d

# Super Admin (Only this email can authenticate as Super Admin)
SUPER_ADMIN_EMAIL=your-super-admin-email@example.com
SUPER_ADMIN_PASSWORD_HASH=your-generated-password-hash

# SMTP / Email Configuration for Registration OTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=HMS <>

# CORS
CLIENT_URL=http://localhost:5173

# Logging
LOG_LEVEL=debug
